# ---------------------------------------------------------------
# Copy this file to server/.env and fill in real values.
# Never commit server/.env
# ---------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Neon PostgreSQL (Dashboard -> Connection string -> Pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=replace_with_a_long_random_string
BETTER_AUTH_URL=http://localhost:5000

# SMTP (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM="Task Management System <no-reply@example.com>"
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# OTP
OTP_PEPPER=replace_with_another_long_random_string
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_ATTEMPTS=5

# Seed account (used only by: npm run seed)
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
